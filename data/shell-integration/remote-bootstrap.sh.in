# Runs on the remote machine (sent by ssh-wrapper.sh): installs the directory
# reporting hook for this session only, then starts the user's own shell.
NEMO_T='__TARGET__'; export NEMO_T
d="$(mktemp -d 2>/dev/null || echo /tmp/nemo-$$)"; mkdir -p "$d"
cat > "$d/hook.sh" <<'NEMO_HOOK'
__HOOK__
NEMO_HOOK
case "$(basename "${SHELL:-sh}")" in
bash)
	{
		echo '[ -f /etc/profile ] && . /etc/profile'
		echo '[ -f ~/.profile ] && . ~/.profile'
		echo '[ -f ~/.bashrc ] && . ~/.bashrc'
		echo ". $d/hook.sh"
	} > "$d/rc"
	exec bash --rcfile "$d/rc" -i ;;
zsh)
	for f in .zshenv .zprofile .zshrc .zlogin; do
		echo "[ -f \"\$HOME/$f\" ] && source \"\$HOME/$f\"" > "$d/$f"
	done
	echo "source $d/hook.sh" >> "$d/.zshrc"
	ZDOTDIR="$d" exec zsh -l ;;
*)
	exec "${SHELL:-sh}" -l ;;
esac
