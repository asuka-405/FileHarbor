#!/usr/bin/env python3
# fileharbor-storage-daemon: "Storage Sense" backend for the FileHarbor fork of Nemo.
#
# Tracks disk usage of a directory tree (default: $HOME) in an SQLite index,
# watches free space, and rescans when it changes by more than a threshold
# (default 200 MB). Exposes the index over the session bus as
# in.archdev.FileHarbor.StorageSense so Nemo's Storage page can query it instantly.
#
# This file is new in the fork and does not exist upstream.

import argparse
import collections
import json
import os
import sqlite3
import sys
import threading
import time

import gi
gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib
try:
    gi.require_version('GLibUnix', '2.0')
    from gi.repository import GLibUnix
    _signal_add = GLibUnix.signal_add
except (ValueError, ImportError):
    _signal_add = GLib.unix_signal_add

BUS_NAME = 'in.archdev.FileHarbor.StorageSense'
OBJ_PATH = '/in/archdev/FileHarbor/StorageSense'

INTROSPECTION = '''
<node>
  <interface name="in.archdev.FileHarbor.StorageSense">
    <method name="GetOverview"><arg type="s" direction="out"/></method>
    <method name="GetChildren"><arg type="s" direction="in"/><arg type="s" direction="out"/></method>
    <method name="GetLargestFiles"><arg type="i" direction="in"/><arg type="s" direction="out"/></method>
    <method name="GetCleanup"><arg type="s" direction="out"/></method>
    <method name="GetTree"><arg type="s" direction="in"/><arg type="i" direction="in"/><arg type="s" direction="out"/></method>
    <method name="GetGrowth"><arg type="i" direction="in"/><arg type="s" direction="out"/></method>
    <method name="GetStatus"><arg type="s" direction="out"/></method>
    <method name="Rescan"/>
    <signal name="Changed"/>
    <property name="Root" type="s" access="read"/>
  </interface>
</node>
'''

EXT_CATS = {
    'Videos': {'mp4', 'mkv', 'avi', 'mov', 'webm', 'wmv', 'flv', 'm4v', 'mpg', 'mpeg', 'ts'},
    'Images': {'jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'tiff', 'tif', 'svg', 'heic', 'raw', 'cr2', 'nef', 'psd', 'xcf'},
    'Audio': {'mp3', 'flac', 'wav', 'ogg', 'opus', 'm4a', 'aac', 'wma'},
    'Documents': {'pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'odt', 'ods', 'odp', 'txt', 'epub', 'md', 'csv'},
    'Archives': {'zip', 'tar', 'gz', 'xz', 'bz2', 'zst', '7z', 'rar', 'tgz', 'tbz2', 'txz'},
    'Disk images': {'iso', 'img', 'qcow2', 'vdi', 'vmdk', 'vhd', 'vhdx', 'raw', 'dmg'},
    'Packages': {'deb', 'rpm', 'appimage', 'flatpak', 'snap', 'pkg'},
}
EXT_TO_CAT = {}
for _cat, _exts in EXT_CATS.items():
    for _e in _exts:
        EXT_TO_CAT.setdefault(_e, _cat)

DEV_DIR_NAMES = {'node_modules', '__pycache__', '.venv', 'venv', '.gradle', '.m2',
                 '.tox', '.mypy_cache', '.pytest_cache', '.next', '.nuxt'}
SKIP_ABS = ('/proc', '/sys', '/dev', '/run')

DB_SCHEMA = '''
CREATE TABLE IF NOT EXISTS dirs(path TEXT PRIMARY KEY, parent TEXT, depth INTEGER,
                                own INTEGER, total INTEGER, nfiles INTEGER, mtime REAL);
CREATE INDEX IF NOT EXISTS dirs_parent ON dirs(parent);
CREATE TABLE IF NOT EXISTS bigfiles(path TEXT PRIMARY KEY, size INTEGER, mtime REAL, cat TEXT);
CREATE INDEX IF NOT EXISTS bigfiles_size ON bigfiles(size);
CREATE TABLE IF NOT EXISTS cats(cat TEXT PRIMARY KEY, size INTEGER, nfiles INTEGER);
CREATE TABLE IF NOT EXISTS cleanup(path TEXT PRIMARY KEY, kind TEXT, size INTEGER, mtime REAL);
CREATE TABLE IF NOT EXISTS snapshots(ts INTEGER, total INTEGER, used INTEGER, free INTEGER, tracked INTEGER);
CREATE INDEX IF NOT EXISTS snapshots_ts ON snapshots(ts);
CREATE TABLE IF NOT EXISTS dirsnap(ts INTEGER, path TEXT, total INTEGER);
CREATE INDEX IF NOT EXISTS dirsnap_ts ON dirsnap(ts);
CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT);
'''


def fmt_size(n):
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if abs(n) < 1000 or unit == 'TB':
            return ('%d %s' % (n, unit)) if unit == 'B' else ('%.1f %s' % (n, unit))
        n /= 1000.0


class Scanner:
    """Walks a tree once and returns an in-memory summary."""

    def __init__(self, root, big_threshold, progress_cb, stop_flag):
        self.root = root
        self.big_threshold = big_threshold
        self.progress_cb = progress_cb
        self.stop_flag = stop_flag
        self.dirs = {}          # path -> [own, total, nfiles, mtime, parent, depth]
        self.big = []           # (path, size, mtime, cat)
        self.cats = collections.defaultdict(lambda: [0, 0])
        self.cleanup = []       # (path, kind, size, mtime)
        self.seen_inodes = set()
        self.nfiles_seen = 0
        self.home = os.path.expanduser('~')

    def run(self):
        try:
            st = os.lstat(self.root)
        except OSError:
            return None
        self._walk(self.root, None, 0, st.st_dev, None)
        return self

    def _classify(self, name, zone):
        if zone:
            return zone
        ext = name.rpartition('.')[2].lower() if '.' in name else ''
        return EXT_TO_CAT.get(ext, 'Other')

    def _walk(self, path, parent, depth, dev, zone):
        # Iterative-recursive hybrid: recursion depth equals tree depth (<< 1000).
        own = 0
        nfiles = 0
        total_children = 0
        try:
            mtime = os.lstat(path).st_mtime
        except OSError:
            mtime = 0.0
        try:
            it = os.scandir(path)
        except OSError:
            self.dirs[path] = [0, 0, 0, mtime, parent, depth]
            return 0
        sub = []
        with it:
            for entry in it:
                if self.stop_flag.is_set():
                    break
                try:
                    if entry.is_symlink():
                        continue
                    st = entry.stat(follow_symlinks=False)
                    if entry.is_dir(follow_symlinks=False):
                        if st.st_dev != dev:
                            continue
                        if entry.path.startswith(SKIP_ABS):
                            continue
                        sub.append((entry.path, entry.name))
                        continue
                    size = st.st_blocks * 512
                    if st.st_nlink > 1:
                        key = (st.st_dev, st.st_ino)
                        if key in self.seen_inodes:
                            continue
                        self.seen_inodes.add(key)
                except OSError:
                    continue
                own += size
                nfiles += 1
                cat = self._classify(entry.name, zone)
                c = self.cats[cat]
                c[0] += size
                c[1] += 1
                if size >= self.big_threshold:
                    self.big.append((entry.path, size, st.st_mtime, cat))
        self.nfiles_seen += nfiles
        if self.nfiles_seen % 20000 < nfiles + 1:
            self.progress_cb(self.nfiles_seen, path)
        for subpath, name in sub:
            if self.stop_flag.is_set():
                break
            z = zone
            kind = None
            if z is None:
                if subpath == os.path.join(self.home, '.cache'):
                    z = 'Cache'
                elif subpath == os.path.join(self.home, '.local/share/Trash'):
                    z = 'Trash'
                    kind = 'trash'
                elif name in DEV_DIR_NAMES:
                    z = 'Dev artifacts'
                    kind = 'dev'
                elif name == 'target' and os.path.exists(os.path.join(path, 'Cargo.toml')):
                    z = 'Dev artifacts'
                    kind = 'dev'
            t = self._walk(subpath, path, depth + 1, dev, z)
            total_children += t
            if kind and t > 0:
                self.cleanup.append((subpath, kind, t, 0.0))
            if (path == os.path.join(self.home, '.cache') and zone == 'Cache' and t > 0):
                self.cleanup.append((subpath, 'cache', t, 0.0))
        total = own + total_children
        self.dirs[path] = [own, total, nfiles, mtime, parent, depth]
        return total


class StorageSense:
    def __init__(self, root, db_path, threshold, interval, full_hours):
        self.root = os.path.realpath(root)
        self.db_path = db_path
        self.threshold = threshold
        self.interval = interval
        self.full_secs = full_hours * 3600
        self.big_threshold = 50 * 1000 * 1000
        self.stop_flag = threading.Event()
        self.scan_lock = threading.Lock()
        self.scanning = False
        self.pending = False
        self.progress = {'files': 0, 'path': ''}
        self.last_scan_ts = 0
        self.last_scan_secs = 0.0
        self.baseline_free = None
        self.last_sample_ts = 0
        self.conn_dbus = None
        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)
        db = self._db()
        db.executescript(DB_SCHEMA)
        row = db.execute("SELECT v FROM meta WHERE k='last_scan_ts'").fetchone()
        if row:
            self.last_scan_ts = int(row[0])
        row = db.execute("SELECT v FROM meta WHERE k='last_scan_secs'").fetchone()
        if row:
            self.last_scan_secs = float(row[0])
        db.commit()
        db.close()

    # ---- database -------------------------------------------------------
    def _db(self):
        db = sqlite3.connect(self.db_path, timeout=30)
        db.execute('PRAGMA journal_mode=WAL')
        return db

    def _statvfs(self):
        s = os.statvfs(self.root)
        total = s.f_blocks * s.f_frsize
        free = s.f_bavail * s.f_frsize
        used = (s.f_blocks - s.f_bfree) * s.f_frsize
        return total, used, free

    # ---- scanning -------------------------------------------------------
    def request_scan(self):
        with self.scan_lock:
            if self.scanning:
                self.pending = True
                return
            self.scanning = True
        threading.Thread(target=self._scan_thread, daemon=True).start()

    def _progress(self, nfiles, path):
        self.progress = {'files': nfiles, 'path': path}

    def _scan_thread(self):
        try:
            try:
                os.nice(10)
            except OSError:
                pass
            start = time.time()
            prev = self._previous_dir_totals()
            sc = Scanner(self.root, self.big_threshold, self._progress, self.stop_flag).run()
            if sc is None or self.stop_flag.is_set():
                return
            ts = int(time.time())
            total, used, free = self._statvfs()
            tracked = sc.dirs[self.root][1] if self.root in sc.dirs else 0
            db = self._db()
            with db:
                db.execute('DELETE FROM dirs')
                db.executemany('INSERT INTO dirs VALUES(?,?,?,?,?,?,?)',
                               [(p, v[4], v[5], v[0], v[1], v[2], v[3]) for p, v in sc.dirs.items()])
                db.execute('DELETE FROM bigfiles')
                big = sorted(sc.big, key=lambda r: -r[1])[:1000]
                db.executemany('INSERT INTO bigfiles VALUES(?,?,?,?)', big)
                db.execute('DELETE FROM cats')
                db.executemany('INSERT INTO cats VALUES(?,?,?)',
                               [(c, v[0], v[1]) for c, v in sc.cats.items()])
                db.execute('DELETE FROM cleanup')
                db.executemany('INSERT OR REPLACE INTO cleanup VALUES(?,?,?,?)', sc.cleanup)
                db.execute('INSERT INTO snapshots VALUES(?,?,?,?,?)', (ts, total, used, free, tracked))
                db.executemany('INSERT INTO dirsnap VALUES(?,?,?)',
                               [(ts, p, v[1]) for p, v in sc.dirs.items() if v[5] <= 3])
                db.execute('DELETE FROM dirsnap WHERE ts < ?', (ts - 30 * 86400,))
                db.execute('DELETE FROM snapshots WHERE ts < ?', (ts - 90 * 86400,))
                secs = time.time() - start
                db.execute("INSERT OR REPLACE INTO meta VALUES('last_scan_ts', ?)", (str(ts),))
                db.execute("INSERT OR REPLACE INTO meta VALUES('last_scan_secs', ?)", (str(secs),))
            db.close()
            self.last_scan_ts = ts
            self.last_scan_secs = secs
            self.baseline_free = free
            self._notify_growth(prev, sc)
            GLib.idle_add(self._emit_changed)
        finally:
            with self.scan_lock:
                self.scanning = False
                again = self.pending
                self.pending = False
            self.progress = {'files': 0, 'path': ''}
            if again:
                GLib.timeout_add_seconds(30, lambda: (self.request_scan(), False)[1])

    def _previous_dir_totals(self):
        try:
            db = self._db()
            rows = db.execute('SELECT path, total FROM dirs WHERE depth <= 2').fetchall()
            db.close()
            return dict(rows)
        except sqlite3.Error:
            return {}

    def _notify_growth(self, prev, sc):
        if not prev:
            return
        best = None
        for path, v in sc.dirs.items():
            if v[5] != 1:
                continue
            delta = v[1] - prev.get(path, v[1])
            if delta >= self.threshold and (best is None or delta > best[1]):
                best = (path, delta)
        if best:
            self._send_notification(
                'Storage grew',
                '%s grew by %s since the last scan.' % (os.path.basename(best[0]) or best[0],
                                                       fmt_size(best[1])))

    def _send_notification(self, title, body):
        def do():
            try:
                bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
                bus.call_sync('org.freedesktop.Notifications', '/org/freedesktop/Notifications',
                              'org.freedesktop.Notifications', 'Notify',
                              GLib.Variant('(susssasa{sv}i)',
                                           ('Nemo Storage', 0, 'drive-harddisk', title, body,
                                            [], {}, 8000)),
                              None, Gio.DBusCallFlags.NONE, 2000, None)
            except GLib.Error:
                pass
        GLib.idle_add(lambda: (do(), False)[1])

    def _emit_changed(self):
        if self.conn_dbus:
            self.conn_dbus.emit_signal(None, OBJ_PATH, BUS_NAME, 'Changed', None)
        return False

    # ---- free space watching -------------------------------------------
    def tick(self):
        try:
            total, used, free = self._statvfs()
        except OSError:
            return True
        now = time.time()
        if self.baseline_free is None:
            self.baseline_free = free
        elif abs(free - self.baseline_free) >= self.threshold and not self.scanning:
            self.request_scan()
        elif now - self.last_scan_ts >= self.full_secs and not self.scanning:
            self.request_scan()
        if now - self.last_sample_ts >= 300 and not self.scanning:
            self.last_sample_ts = now
            try:
                db = self._db()
                with db:
                    db.execute('INSERT INTO snapshots VALUES(?,?,?,?,NULL)',
                               (int(now), total, used, free))
                db.close()
            except sqlite3.Error:
                pass
        return True

    # ---- queries (JSON) -------------------------------------------------
    def q_status(self):
        total, used, free = self._statvfs()
        return json.dumps({'root': self.root, 'scanning': self.scanning,
                           'progress': self.progress, 'last_scan': self.last_scan_ts,
                           'last_scan_secs': self.last_scan_secs, 'threshold': self.threshold,
                           'total': total, 'used': used, 'free': free})

    def q_overview(self):
        db = self._db()
        total, used, free = self._statvfs()
        row = db.execute('SELECT total, nfiles FROM dirs WHERE path=?', (self.root,)).fetchone()
        tracked = row[0] if row else 0
        cats = [dict(cat=r[0], size=r[1], nfiles=r[2]) for r in
                db.execute('SELECT cat,size,nfiles FROM cats ORDER BY size DESC')]
        top = [dict(path=r[0], name=os.path.basename(r[0]), total=r[1], nfiles=r[2]) for r in
               db.execute('SELECT path,total,nfiles FROM dirs WHERE parent=? ORDER BY total DESC LIMIT 12',
                          (self.root,))]
        since = int(time.time()) - 7 * 86400
        timeline = [dict(ts=r[0], used=r[1], free=r[2]) for r in
                    db.execute('SELECT ts,used,free FROM snapshots WHERE ts>=? ORDER BY ts', (since,))]
        if len(timeline) > 300:
            step = len(timeline) / 300.0
            timeline = [timeline[int(i * step)] for i in range(300)]
        db.close()
        return json.dumps({'root': self.root, 'total': total, 'used': used, 'free': free,
                           'tracked': tracked, 'categories': cats, 'top': top,
                           'timeline': timeline, 'scanning': self.scanning,
                           'last_scan': self.last_scan_ts})

    def q_children(self, path):
        path = os.path.realpath(path or self.root)
        db = self._db()
        row = db.execute('SELECT own, total, nfiles FROM dirs WHERE path=?', (path,)).fetchone()
        kids = [dict(path=r[0], name=os.path.basename(r[0]), total=r[1], nfiles=r[2]) for r in
                db.execute('SELECT path,total,nfiles FROM dirs WHERE parent=? ORDER BY total DESC LIMIT 500',
                           (path,))]
        db.close()
        return json.dumps({'path': path, 'parent': os.path.dirname(path) if path != self.root else None,
                           'own': row[0] if row else 0, 'total': row[1] if row else 0,
                           'nfiles': row[2] if row else 0, 'children': kids})

    def q_largest(self, n):
        db = self._db()
        rows = [dict(path=r[0], name=os.path.basename(r[0]), size=r[1], mtime=r[2], cat=r[3]) for r in
                db.execute('SELECT path,size,mtime,cat FROM bigfiles ORDER BY size DESC LIMIT ?', (max(1, n),))]
        db.close()
        return json.dumps(rows)

    def q_tree(self, path, depth):
        """Nested size tree for the treemap view: biggest folders first, with the
        remaining files and tiny folders merged into a '(files)' pseudo-entry."""
        path = os.path.realpath(path or self.root)
        db = self._db()
        budget = [1200]

        def build(p, d):
            row = db.execute('SELECT own, total FROM dirs WHERE path=?', (p,)).fetchone()
            if not row:
                return None
            own, total = row
            node = {'name': os.path.basename(p) or p, 'path': p, 'size': total,
                    'kind': 'dir', 'children': []}
            if d > 0 and budget[0] > 0:
                shown = 0
                rows = db.execute('SELECT path, total FROM dirs WHERE parent=? AND total>0 '
                                  'ORDER BY total DESC LIMIT 16', (p,)).fetchall()
                for kp, kt in rows:
                    if budget[0] <= 0:
                        break
                    budget[0] -= 1
                    child = build(kp, d - 1)
                    if child:
                        node['children'].append(child)
                        shown += child['size']
                loose = max(total - shown, 0)
                if loose > 0 and node['children']:
                    node['children'].append({'name': '(files)', 'path': '', 'size': loose,
                                             'kind': 'files', 'children': []})
            return node

        tree = build(path, max(1, min(depth, 4)))
        db.close()
        out = tree or {'name': path, 'path': path, 'size': 0, 'kind': 'dir', 'children': []}
        out['parent'] = os.path.dirname(path) if path != self.root else None
        return json.dumps(out)

    def q_cleanup(self):
        db = self._db()
        rows = [dict(path=r[0], name=os.path.basename(r[0]) or r[0], kind=r[1], size=r[2]) for r in
                db.execute('SELECT path,kind,size FROM cleanup ORDER BY size DESC LIMIT 200')]
        old = [dict(path=r[0], name=os.path.basename(r[0]), kind='old-download', size=r[1]) for r in
               db.execute("SELECT path,size FROM bigfiles WHERE path LIKE ? AND mtime < ? ORDER BY size DESC LIMIT 50",
                          (os.path.join(os.path.expanduser('~'), 'Downloads') + '/%', time.time() - 90 * 86400))]
        db.close()
        return json.dumps(rows + old)

    def q_growth(self, hours):
        db = self._db()
        latest = db.execute('SELECT MAX(ts) FROM dirsnap').fetchone()[0]
        out = []
        if latest:
            cutoff = latest - max(1, hours) * 3600
            base_ts = db.execute('SELECT MAX(ts) FROM dirsnap WHERE ts <= ?', (cutoff,)).fetchone()[0]
            if base_ts is None:
                base_ts = db.execute('SELECT MIN(ts) FROM dirsnap').fetchone()[0]
            if base_ts is not None and base_ts != latest:
                rows = db.execute(
                    'SELECT a.path, a.total, b.total FROM dirsnap a LEFT JOIN dirsnap b '
                    'ON a.path=b.path AND b.ts=? WHERE a.ts=? ', (base_ts, latest)).fetchall()
                for p, now_t, old_t in rows:
                    delta = now_t - (old_t if old_t is not None else 0)
                    if delta != 0 and p != self.root:
                        out.append(dict(path=p, name=os.path.basename(p), delta=delta, total=now_t))
                out.sort(key=lambda r: -abs(r['delta']))
                out = out[:40]
        db.close()
        return json.dumps(out)

    # ---- D-Bus ----------------------------------------------------------
    def on_method(self, conn, sender, path, iface, method, params, invocation):
        try:
            if method == 'GetOverview':
                r = self.q_overview()
            elif method == 'GetChildren':
                r = self.q_children(params.unpack()[0])
            elif method == 'GetLargestFiles':
                r = self.q_largest(params.unpack()[0])
            elif method == 'GetTree':
                a = params.unpack()
                r = self.q_tree(a[0], a[1])
            elif method == 'GetCleanup':
                r = self.q_cleanup()
            elif method == 'GetGrowth':
                r = self.q_growth(params.unpack()[0])
            elif method == 'GetStatus':
                r = self.q_status()
            elif method == 'Rescan':
                self.request_scan()
                invocation.return_value(None)
                return
            else:
                invocation.return_error_literal(Gio.dbus_error_quark(), 19, 'unknown method')
                return
            invocation.return_value(GLib.Variant('(s)', (r,)))
        except Exception as exc:  # keep the daemon alive on query errors
            invocation.return_error_literal(Gio.dbus_error_quark(), 0, str(exc))

    def on_get_property(self, conn, sender, path, iface, name):
        if name == 'Root':
            return GLib.Variant('s', self.root)
        return None

    def on_bus_acquired(self, conn, name):
        self.conn_dbus = conn
        node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)
        conn.register_object(OBJ_PATH, node.interfaces[0], self.on_method, self.on_get_property, None)

    def on_name_lost(self, conn, name):
        sys.stderr.write('fileharbor-storage-daemon: could not own %s (already running?)\n' % name)
        sys.exit(1)

    def run(self):
        Gio.bus_own_name(Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.NONE,
                         self.on_bus_acquired, None, self.on_name_lost)
        loop = GLib.MainLoop()
        _signal_add(GLib.PRIORITY_DEFAULT, 15, lambda: (self.stop_flag.set(), loop.quit(), False)[2])
        _signal_add(GLib.PRIORITY_DEFAULT, 2, lambda: (self.stop_flag.set(), loop.quit(), False)[2])
        stale = time.time() - self.last_scan_ts > 3600
        if stale:
            GLib.timeout_add_seconds(5, lambda: (self.request_scan(), False)[1])
        GLib.timeout_add_seconds(self.interval, self.tick)
        loop.run()


def main():
    ap = argparse.ArgumentParser(description='Nemo Storage Sense daemon')
    ap.add_argument('--root', default=os.path.expanduser('~'),
                    help='tree to track (default: home directory; use / for whole system)')
    ap.add_argument('--threshold-mb', type=int, default=200,
                    help='rescan when free space changes by this many MB (default 200)')
    ap.add_argument('--interval', type=int, default=15, help='free-space poll interval, seconds')
    ap.add_argument('--full-hours', type=float, default=6, help='force a rescan this often')
    ap.add_argument('--db', default=os.path.join(GLib.get_user_data_dir(), 'nemo-storage-sense', 'index.db'))
    ap.add_argument('--scan-once', action='store_true', help='scan, print a summary, exit')
    args = ap.parse_args()
    ss = StorageSense(args.root, args.db, args.threshold_mb * 1000 * 1000, args.interval, args.full_hours)
    if args.scan_once:
        ss.scanning = True
        ss._scan_thread()
        print(json.dumps(json.loads(ss.q_overview()), indent=1)[:3000])
        return
    ss.run()


if __name__ == '__main__':
    main()
