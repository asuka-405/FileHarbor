#!/usr/bin/env python3
# FileHarbor built-in tools launcher.
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for cand in (os.path.join(here, "..", "share", "nemo", "tools"), here):
    if os.path.isdir(os.path.join(cand, "fhtools")):
        sys.path.insert(0, os.path.abspath(cand))
        break
from fhtools.__main__ import main

raise SystemExit(main(sys.argv))
